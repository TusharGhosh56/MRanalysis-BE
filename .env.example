# Application
APP_NAME=GitHub Analytics API
DEBUG=false
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database 
DATABASE_URL=postgresql+psycopg://github_analytics:github_analytics@localhost:5433/github_analytics

# JWT 
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password policy
PASSWORD_MIN_LENGTH=8

# Redis / Celery (Deprecated - no longer required; in-process workers and in-memory cache used)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Git / analytics
REPOS_BASE_PATH=./data/repos
ANALYTICS_CACHE_TTL_SECONDS=300
GIT_CLONE_TIMEOUT_SECONDS=600
PARSE_BATCH_SIZE=500
PARSE_USE_GIT_LOG=true
# Cap commits for very large repos (0 = unlimited). Example: 10000
ANALYSIS_MAX_COMMITS=0
INACTIVE_CONTRIBUTOR_DAYS=90
JOB_POLL_TIMEOUT_SECONDS=240
